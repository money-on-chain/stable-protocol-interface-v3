# moc-v1 — mainnet (RSK mainnet, chain 30)
# Legacy v1 MoC contracts (main-RBTC-contract) — connector-based discovery, no caIndex/MocQueue.
# All REACT_APP_* variables are bundled into the JS by Vite and are public.
# Do NOT add private keys, API tokens, or passwords. See .env.example for full reference.
# REACT_APP_WALLET_CONNECT_PROJECT_ID is a public credential — use one project ID per target.

SKIP_PREFLIGHT_CHECK=true
REACT_APP_PUBLIC_URL=
REACT_APP_ENVIRONMENT_APP_PROJECT=moc-v1
REACT_APP_CONTRACT_MOC_V1=0xf773B590aF754D597770937Fa8ea7AbDf2668370
REACT_APP_CONTRACT_MULTICALL2=0x8f344c3b2a02a801c24635f594c5652c8a2eb02a
REACT_APP_ENVIRONMENT_VENDOR_ADDRESS=0xC61820bFB8F87391d62Cd3976dDc1d35e0cf7128
REACT_APP_CONTRACT_IREGISTRY=0xCD101a2414256DA8F8E25d7b483b3cf639a71683
REACT_APP_ENVIRONMENT_API_OPERATIONS=https://api-operations.moneyonchain.com/api/v1/
REACT_APP_ENVIRONMENT_CHAIN_ID=30
REACT_APP_ENVIRONMENT_EXPLORER_URL=https://explorer.rsk.co
REACT_APP_WALLET_CONNECT_PROJECT_ID=
REACT_APP_WAIT_REFRESH_BLOCKCHAIN=20000
REACT_APP_RSK_MAINNET_RPC=https://public-node.rsk.co
