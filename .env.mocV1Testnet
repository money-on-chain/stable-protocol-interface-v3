# moc-v1 — testnet (RSK testnet, chain 31)
# Legacy v1 MoC contracts (main-RBTC-contract) — connector-based discovery, no caIndex/MocQueue.
# All REACT_APP_* variables are bundled into the JS by Vite and are public.
# Do NOT add private keys, API tokens, or passwords. See .env.example for full reference.
# REACT_APP_WALLET_CONNECT_PROJECT_ID is a public credential — use one project ID per target.

SKIP_PREFLIGHT_CHECK=true
REACT_APP_PUBLIC_URL=
REACT_APP_ENVIRONMENT_APP_PROJECT=moc-v1
REACT_APP_CONTRACT_MOC_V1=0x2820f6d4D199B8D8838A4B26F9917754B86a0c1F
REACT_APP_CONTRACT_MULTICALL2=0xaf7be1ef9537018feda5397d9e3bb9a1e4e27ac8
REACT_APP_ENVIRONMENT_VENDOR_ADDRESS=0xf69287F5Ca3cC3C6d3981f2412109110cB8af076
REACT_APP_CONTRACT_IREGISTRY=0xf078375a3dD89dDF4D9dA460352199C6769b5f10
REACT_APP_ENVIRONMENT_API_OPERATIONS=https://api-operations-testnet.moneyonchain.com/api/v1/
REACT_APP_ENVIRONMENT_API_INCENTIVES=https://moc-incentives-testnet.moneyonchain.com/
REACT_APP_ENVIRONMENT_CHAIN_ID=31
REACT_APP_ENVIRONMENT_EXPLORER_URL=https://explorer.testnet.rsk.co
REACT_APP_WALLET_CONNECT_PROJECT_ID=
REACT_APP_WAIT_REFRESH_BLOCKCHAIN=20000
REACT_APP_RSK_TESTNET_RPC=https://public-node.testnet.rsk.co
