{
    "extends": "./tsconfig.json",
    "compilerOptions": {
      "noEmit": true,
      "noUnusedLocals": false,
      "noUnusedParameters": false
    },
    "include": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "src/**/*.js",
      "src/**/*.jsx"
    ],
    "exclude": [
      "node_modules",
      "dist",
      "build",
      "coverage",
      "public",
      "src/generated",
      "types/ethers-contracts"
    ]
  }
  