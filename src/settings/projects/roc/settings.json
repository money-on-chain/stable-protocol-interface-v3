{
    "project": "roc",
    "dapp": {
        "name": "ROC UI",
        "description": "ROC UI"
    },
    "showPriceVariation": false,
    "useCombinedOperationsRedeemableLimit": true,
    "slippage": {
        "autoDefault": 0.25,
        "presets": [0.2, 0.25, 0.35],
        "max": 5.0
    },
    "exchange": {
        "tokenMap": {
            "blacklist": ["TC_1"]
        }
    },
    "combinedOperations": {
        "tokenMap": {
            "blacklist": ["CA_1", "TC_1"]
        }
    },
    "tokenPriceStrip": {
        "tokens": ["CA_0", "TP_0", "TC_0", "CA_1", "TF_0", "COINBASE"]
    },
    "defaults": {
        "tokens": {
            "name": "TICKER",
            "fullName": "Token Name",
            "decimals": 18,
            "visibleDecimals": 6,
            "visiblePriceDecimals": 2,
            "visiblePriceUSD": 8,
            "visibleBalanceDecimals": 8,
            "visibleBalanceUSDDecimals": 2,
            "peggedUSD": false
        }
    },
    "tokens": {
        "COINBASE": [
            {"key": 0, "token": "RBTC"}
        ],
        "CA": [
            {"key": 0, "token": "RIF"},
            {"key": 1, "token": "DOC"}
        ],
        "TP": [
            {"key": 0, "token": "USDRIF"}
        ],
        "TC": [
            {"key": 0, "token": "RIFP"},
            {"key": 1, "token": "ROCR"}
        ],
        "TF": [
            {"key": 0, "token": "MOC"},
            {"key": 1, "token": "MOC"}
        ],
        "TG": [
            {"key": 0, "token": "MOC"}
        ]
    }
}
