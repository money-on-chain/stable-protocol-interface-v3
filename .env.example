# Environment configuration template
#
# Copy this file to the appropriate target file (e.g. .env.rocTestnet) and fill in the values.
# All REACT_APP_* variables are inlined into the frontend JS bundle by Vite at build time.
# They are NOT secrets — do not put private keys, API tokens, or passwords here.
#
# REACT_APP_WALLET_CONNECT_PROJECT_ID / REACT_APP_RLOGIN_WALLETCONNECT2_PROJECTID
#   These are WalletConnect Cloud project IDs. They are public-by-design (shipped in the bundle),
#   but are scoped to an allowed domain list configured in WalletConnect Cloud. Use a separate
#   project ID per deployment target and do not reuse them as credentials elsewhere.

# ---------------------------------------------------------------------------
# App identity
# ---------------------------------------------------------------------------
REACT_APP_PUBLIC_URL=
REACT_APP_ENVIRONMENT_APP_PROJECT=           # roc | flipmoney | voting | stablex

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
REACT_APP_ENVIRONMENT_CHAIN_ID=              # 30 (RSK mainnet) | 31 (RSK testnet) | 1337 (localhost)
REACT_APP_ENVIRONMENT_EXPLORER_URL=          # https://explorer.rsk.co
REACT_APP_ENVIRONMENT_BTC_EXPLORER=          # https://live.blockcypher.com/btc-testnet  (flipmoney only)
REACT_APP_RSK_LOCALHOST_RPC=                 # http://127.0.0.1:8545  (localhost targets only)

# ---------------------------------------------------------------------------
# Wallet / WalletConnect
# ---------------------------------------------------------------------------
# Public project credential — scoped to an allowed domain in WalletConnect Cloud.
# Create a separate project per deployment target at https://cloud.walletconnect.com
REACT_APP_WALLET_CONNECT_PROJECT_ID=
REACT_APP_RLOGIN_WALLETCONNECT2_PROJECTID=

# ---------------------------------------------------------------------------
# Contract addresses
# ---------------------------------------------------------------------------
REACT_APP_CONTRACT_MULTICALL2=
REACT_APP_CONTRACT_MULTICOLLATERAL_GUARD=
REACT_APP_CONTRACT_IREGISTRY=
REACT_APP_CONTRACT_PRICE_PROVIDER_CA=        # comma-separated list
REACT_APP_CONTRACT_PRICE_PROVIDER_COINBASE=
REACT_APP_CONTRACT_PRICE_PROVIDER_CUSTOM=
REACT_APP_CONTRACT_TC=                       # voting only
REACT_APP_CONTRACT_LEGACY_TP=
REACT_APP_CONTRACT_TOKEN_MIGRATOR=
REACT_APP_CONTRACT_INCENTIVE_V2=             # flipmoney only
REACT_APP_CONTRACT_VETO_MOC=                 # voting only
REACT_APP_CONTRACT_VETO_TC=                  # voting only
REACT_APP_CONTRACT_MOC=                      # voting only
REACT_APP_ENVIRONMENT_VENDOR_ADDRESS=

# ---------------------------------------------------------------------------
# API / off-chain services
# ---------------------------------------------------------------------------
# Must be an origin listed in ALLOWED_API_ORIGINS inside src/services/apiConfig.ts.
# Leave empty to disable the operations history table.
REACT_APP_ENVIRONMENT_API_OPERATIONS=

REACT_APP_PRICE_OFFCHAIN_API=                # https://api-chain-monitor.moneyonchain.com/

# ---------------------------------------------------------------------------
# RNS (RIF Name Service) — flipmoney only
# ---------------------------------------------------------------------------
REACT_APP_ENVIRONMENT_RNS_ADDRESS=
REACT_APP_ENVIRONMENT_RNS_URL=

# ---------------------------------------------------------------------------
# Polling / timing
# ---------------------------------------------------------------------------
REACT_APP_WAIT_REFRESH_BLOCKCHAIN=20000      # ms between blockchain state refreshes

# ---------------------------------------------------------------------------
# Legacy (kept for backward compat, not used by current build)
# ---------------------------------------------------------------------------
SKIP_PREFLIGHT_CHECK=true
